{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HI JACK LIVE module.json contract v1",
  "type": "object",
  "required": ["id", "name", "version", "host_api", "entrypoint", "provides", "requires", "optional", "permissions", "enabled"],
  "properties": {
    "id": {"type": "string", "pattern": "^hj\\.[a-z][a-z0-9_]{1,50}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "host_api": {"enum": ["1.x", "1.0.0"]},
    "entrypoint": {"type": "string", "pattern": "^backend\\.[a-z_][a-z0-9_.]*:[a-z_][a-z0-9_]*$"},
    "provides": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "enabled": {"type": "boolean"},
    "data_schema": {"type": "integer", "minimum": 0, "maximum": 9999},
    "ui": {"type": "object"}
  }
}
